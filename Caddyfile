# TLS-terminating reverse proxy for the self-hosted setup (docker-compose.yml).
# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically;
# WebSocket upgrades (Socket.IO) pass through reverse_proxy unchanged.
{$DOMAIN} {
    # (Stock Caddy has no Brotli encoder — "br" here would stop it from starting.)
    encode zstd gzip
    reverse_proxy game:3000
}

# Redirect www to the bare domain.
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}
