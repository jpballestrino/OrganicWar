PORT=3000

# REQUIRED in production — must be a long random string (e.g. openssl rand -hex 64).
# If unset in production the server will refuse to start.
JWT_SECRET=dev_jwt_secret_key_change_me_in_production

# Where the SQLite database (and its hourly backups, in backups/ beside it)
# live. Put it on persistent storage in production, e.g. /data/organicwar.db.
# DB_PATH=/data/organicwar.db

# Number of reverse-proxy hops in front of the server (Render, Caddy, nginx = 1).
# Needed for real player IPs (per-IP limits) and https OAuth callbacks.
# 0 = no proxy (local development).
TRUST_PROXY=0

# Max simultaneous rooms. Leave unset: the server derives it from the CPU and
# memory it may use (container limits included) — see GET /healthz → capacity.
# MAX_CONCURRENT_ROOMS=8

# Self-hosting with docker-compose.yml + Caddy: your domain (DNS must point here).
# DOMAIN=organicwar.io

# Max simultaneous WebSocket connections from a single IP (prevents slot-farming / ELO abuse).
# Localhost connections are always exempt so dev tools aren't blocked.
MAX_CONNECTIONS_PER_IP=5

# Simulation tick rate (Hz). Higher = smoother conquest but more CPU. 25 is the default.
SIM_TICK_HZ=25

# Set to 1 to log per-room tick/snapshot profiling every 5 seconds (dev/perf tuning only).
SIM_PROFILE=0

# SSL — set to file paths for Node-level TLS termination.
# In production, prefer Render or the Caddy setup in docker-compose.yml.
# SSL_CERT=/etc/ssl/certs/your-cert.pem
# SSL_KEY=/etc/ssl/private/your-key.pem

# Public URL of your deployed server (no trailing slash).
# Used to build links in emails (password reset, email verification).
# In production on Render, set this to e.g. https://organicwar.onrender.com
APP_URL=http://localhost:3000

# Node Mailer config (for password reset and email verification)
# Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# OAuth login client details (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Origins allowed to open a socket from another site. The game itself is served
# from the same origin, so this only matters for third-party embeds.
CORS_ORIGIN=*
